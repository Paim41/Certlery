NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Env-only admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional: use this JSON array for multiple admin accounts. The single account
# above can remain as a fallback while you test the new logins.
ADMIN_ACCOUNTS=[{"username":"admin","password":"replace-with-a-long-unique-password"},{"username":"editor","password":"replace-with-another-long-unique-password"}]
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
TELEGRAM_WEBHOOK_SECRET=letters-numbers-underscore-and-hyphen-only

# Persistent certificate files and metadata
# Vercel creates this automatically when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace-with-your-token
